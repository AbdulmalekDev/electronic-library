{
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.usePolling": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/build/**": true,
        "**/dist/**": true
    },
    "editor.formatOnSave": true
}
